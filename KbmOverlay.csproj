<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11, so the exe needs no runtime install. -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KbmOverlay</AssemblyName>
    <RootNamespace>KbmOverlay</RootNamespace>
    <Version>0.7.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Overlay pages are embedded so the exe is a single file. A "pages" folder next to the exe overrides them. -->
    <EmbeddedResource Include="pages\**\*" LogicalName="pages/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- License texts travel inside the exe and are shown at http://localhost:5520/licenses.html. -->
    <EmbeddedResource Include="LICENSE" LogicalName="pages/licenses/LICENSE.txt" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt" LogicalName="pages/licenses/THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
